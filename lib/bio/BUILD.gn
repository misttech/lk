import("//build/zircon/zx_library.gni")

zx_library("bio") {
  sources = [
    "bio.cc",
    "debug.cc",
    "mem.cc",
    "subdev.cc",
  ]

  deps = [
    "//vendor/misttech/lib/lk_redirect",
    "//zircon/kernel/lib/console",
    "//zircon/kernel/lib/init",
    "//zircon/system/ulib/pretty",
  ]

  public_deps = [ "//vendor/misttech/lib/lk_redirect:headers" ]

  configs += [
    "//vendor/misttech/lib/lk_redirect:suppress-warning",
    "//build/config:Wno-vla-cxx-extension",
  ]
}
