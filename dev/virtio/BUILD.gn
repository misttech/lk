import("//build/zircon/zx_library.gni")

zx_library("virtio") {
  sources = [
    "ring.cpp",
    "virtio_pci.cpp",
  ]

  deps = [
    "//third_party/lk/dev/bus/pci:headers",
    "//third_party/lk/dev/virtio/block:virtio-block.headers",
    "//zircon/kernel/lib/init",
    "//zircon/kernel/vm",
  ]

  public_configs = [ "//src/lib/ddk:include" ]

  public_deps = [ "//zircon/system/ulib/virtio" ]
}
