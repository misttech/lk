import("//build/zircon/zx_library.gni")

zx_library("pci") {
  sources = [
    "backend/ecam.cpp",
    "backend/type1.cpp",
    "bus_mgr/bridge.cpp",
    "bus_mgr/bus.cpp",
    "bus_mgr/bus_mgr.cpp",
    "bus_mgr/device.cpp",
    "bus_mgr/resource.cpp",
    "debug.cpp",
    "pci.cpp",
  ]

  deps = [
    "//zircon/kernel/lib/console",
    "//zircon/kernel/vm:headers",
    "//zircon/system/ulib/pretty",
  ]

  public_deps = [
    "//third_party/lk/dev",
    "//vendor/misttech/lib/lk_redirect:headers",

    # <dev/pcie_platform.h> has #include <dev/interrupt.h>.
    "//zircon/kernel/dev/interrupt:headers",
  ]

  cflags_cc = [
    "-Wno-invalid-offsetof",
    "-Wmissing-declarations",
  ]

  configs += [ ":suppress-warning" ]
}

config("suppress-warning") {
  cflags_cc = [ "-Wno-implicit-int-conversion" ]
}
